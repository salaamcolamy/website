# =============================================================================
# DEVELOPMENT ENVIRONMENT VARIABLES - SALAAM COLA
# =============================================================================
# Copy this to .env.local and fill in your credentials.
# NEVER commit .env.local to version control.

# Shopify Storefront API (REQUIRED)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Shopify Admin API (Required for order creation)
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your-admin-token

# Billplz Payment Gateway - SANDBOX
BILLPLZ_API_KEY=your-billplz-api-key
BILLPLZ_COLLECTION_ID=your-collection-id
BILLPLZ_SANDBOX=true
BILLPLZ_XSIGNATURE_KEY=your-xsignature-key

# Site Configuration (OPTIONAL in development)
NEXT_PUBLIC_SITE_URL=

# Security Configuration (OPTIONAL in development)
ALLOWED_ORIGINS=

# Advanced Shipping Rules API (OPTIONAL - rates come through Shopify automatically)
# Note: Direct API requires both App ID (contact Advanced Shipping for App ID) and API Key
ADVANCED_SHIPPING_APP_ID=your-app-id
ADVANCED_SHIPPING_API_KEY=8270f9c-3581-476c-b0c6-771f59093679
